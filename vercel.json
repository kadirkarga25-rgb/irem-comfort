{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/private-catalogs",
      "destination": "/api/private-catalogs.ts"
    },
    {
      "source": "/toptananket",
      "destination": "/toptananket.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
